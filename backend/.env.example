# Server Configuration
PORT=3001
NODE_ENV=development

# AI provider: 'openrouter', 'openai' or 'mock'
AI_PROVIDER=openrouter

# OpenRouter Configuration
# Model can be any OpenRouter model ID, e.g. anthropic/claude-haiku-4.5, openai/gpt-5-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Storage Configuration
UPLOADS_DIR=./uploads

# Uploads Cleanup Configuration
# Maximum disk space for uploads directory (e.g., "1GB", "500MB", "2.5GB")
# When exceeded, oldest files will be deleted automatically
# Leave empty or comment out to disable automatic cleanup
MAX_UPLOADS_DISK_SIZE=1GB

# Cleanup interval in hours (default: 24)
# How often to run the periodic cleanup check
CLEANUP_INTERVAL_HOURS=24

# Database Configuration
DATABASE_PATH=./data/receipts.db

# Beancount Ledger Service Configuration
BEANCOUNT_SERVICE_URL=http://localhost:8000
