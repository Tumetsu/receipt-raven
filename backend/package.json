{
  "name": "receipt-raven-backend",
  "version": "1.0.0",
  "description": "Receipt Raven Backend - Fastify + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:frontend": "cd ../frontend && npm install && npm run build",
    "copy:frontend": "rm -rf ./dist/public && mkdir -p ./dist/public && cp -r ../frontend/dist/* ./dist/public/",
    "build:full": "npm run build:frontend && npm run build && npm run copy:frontend",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "migration:create": "kysely migrate:make new-migration",
    "migration:run": "kysely migrate latest",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "copy_production": "npm run copy_production_db && npm run copy_production_uploads",
    "copy_production_db": "scp root@services-vm.home.arpa:/mnt/storage/receipt-raven/data/receipts.db ./data/receipts.db",
    "copy_production_uploads": "rm -rf ./uploads && scp -r root@services-vm.home.arpa:/mnt/storage/receipt-raven/uploads/ ./uploads/"
  },
  "keywords": [
    "fastify",
    "typescript",
    "receipt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "kysely": "^0.28.7",
    "kysely-ctl": "^0.19.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "openai": "^4.76.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/lodash": "^4.17.20",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.9",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2"
  }
}
