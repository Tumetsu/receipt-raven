{
  "openapi": "3.1.0",
  "info": {
    "title": "Receipt Raven API",
    "description": "API for processing and managing receipts",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/upload": {
      "post": {
        "tags": [
          "upload"
        ],
        "description": "Upload a receipt image for processing",
        "responses": {
          "200": {
            "description": "Successful upload response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Successful upload response",
                  "type": "object",
                  "properties": {
                    "success": {
                      "description": "Whether the upload was successful",
                      "type": "boolean"
                    },
                    "filename": {
                      "description": "Name of the uploaded file",
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "filename"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error response for failed upload",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response for failed upload",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error message describing what went wrong",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/accounts": {
      "get": {
        "tags": [
          "ledger"
        ],
        "description": "Get all accounts from the ledger",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "type",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/payees": {
      "get": {
        "tags": [
          "ledger"
        ],
        "description": "Get list of payees (shops, vendors) from the ledger",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payees": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "payees"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/receipts": {
      "get": {
        "tags": [
          "receipts"
        ],
        "description": "Get paginated receipts",
        "parameters": [
          {
            "schema": {
              "default": 1,
              "type": "number",
              "minimum": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number (starting from 1)"
          },
          {
            "schema": {
              "default": 30,
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "pageSize",
            "required": false,
            "description": "Number of items per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated receipts response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Paginated receipts response",
                  "type": "object",
                  "properties": {
                    "receipts": {
                      "description": "Array of receipts",
                      "type": "array",
                      "items": {
                        "description": "A receipt with all its details",
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Unique identifier for the receipt",
                            "type": "number"
                          },
                          "payee": {
                            "description": "Name of the shop or vendor",
                            "type": "string"
                          },
                          "description": {
                            "description": "Description or summary of the receipt",
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "sourceAccount": {
                            "description": "Source account for the payment (optional)",
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "date": {
                            "description": "Date of the receipt (ISO 8601 format)",
                            "type": "string"
                          },
                          "totalSum": {
                            "description": "Total amount of the receipt",
                            "type": "number"
                          },
                          "status": {
                            "description": "Status of the receipt (pending, approved, rejected, or error)",
                            "type": "string",
                            "enum": [
                              "approved",
                              "unapproved"
                            ]
                          },
                          "filename": {
                            "description": "Filename of the receipt image",
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "fileUrl": {
                            "description": "URL to access the receipt image",
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "payee",
                          "description",
                          "date",
                          "totalSum",
                          "status",
                          "filename",
                          "fileUrl"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "total": {
                      "description": "Total number of receipts",
                      "type": "number"
                    },
                    "page": {
                      "description": "Current page number",
                      "type": "number"
                    },
                    "pageSize": {
                      "description": "Number of items per page",
                      "type": "number"
                    },
                    "totalPages": {
                      "description": "Total number of pages",
                      "type": "number"
                    }
                  },
                  "required": [
                    "receipts",
                    "total",
                    "page",
                    "pageSize",
                    "totalPages"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "receipts"
        ],
        "description": "Create a new manual receipt",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Data required to create a new manual receipt",
                "type": "object",
                "properties": {
                  "payee": {
                    "description": "Name of the shop or vendor",
                    "type": "string"
                  },
                  "description": {
                    "description": "Description or summary of the receipt",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceAccount": {
                    "description": "Source account for the payment (optional)",
                    "type": "string"
                  },
                  "date": {
                    "description": "Date of the receipt (ISO 8601 format)",
                    "type": "string"
                  },
                  "totalSum": {
                    "description": "Total amount of the receipt",
                    "type": "number"
                  },
                  "items": {
                    "description": "List of items in the receipt (at least 1 required)",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "Name of the purchased item",
                          "type": "string"
                        },
                        "price": {
                          "description": "Price of the item",
                          "type": "number"
                        },
                        "expenseAccount": {
                          "description": "Ledger expense account for this item",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "price",
                        "expenseAccount"
                      ]
                    }
                  }
                },
                "required": [
                  "payee",
                  "description",
                  "sourceAccount",
                  "date",
                  "totalSum",
                  "items"
                ]
              }
            }
          },
          "required": true,
          "description": "Data required to create a new manual receipt"
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "ID of the created receipt",
                      "type": "number"
                    },
                    "success": {
                      "description": "Whether the operation was successful",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error type or title",
                      "type": "string"
                    },
                    "message": {
                      "description": "Detailed error message",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error type or title",
                      "type": "string"
                    },
                    "message": {
                      "description": "Detailed error message",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/receipts/{receiptId}": {
      "post": {
        "tags": [
          "receipts"
        ],
        "description": "Save receipt and its items to the ledger",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Data required to submit a receipt to the ledger",
                "type": "object",
                "properties": {
                  "sourceAccount": {
                    "description": "Source account for the payment",
                    "type": "string"
                  },
                  "description": {
                    "description": "Description or summary of the receipt",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "payee": {
                    "description": "Name of the shop or vendor",
                    "type": "string"
                  },
                  "date": {
                    "description": "Date of the receipt (ISO 8601 format)",
                    "type": "string"
                  },
                  "totalSum": {
                    "description": "Total amount of the receipt",
                    "type": "number"
                  },
                  "items": {
                    "description": "List of items in the receipt (at least 1 required)",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "description": "ID of existing item (omit for new items)",
                          "type": "number"
                        },
                        "name": {
                          "description": "Name of the purchased item",
                          "type": "string"
                        },
                        "price": {
                          "description": "Price of the item",
                          "type": "number"
                        },
                        "expenseAccount": {
                          "description": "Ledger expense account for this item",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "price",
                        "expenseAccount"
                      ]
                    }
                  }
                },
                "required": [
                  "sourceAccount",
                  "description",
                  "payee",
                  "date",
                  "totalSum",
                  "items"
                ]
              }
            }
          },
          "required": true,
          "description": "Data required to submit a receipt to the ledger"
        },
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "path",
            "name": "receiptId",
            "required": true,
            "description": "ID of the receipt"
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Success response",
                  "type": "object",
                  "properties": {
                    "success": {
                      "description": "Whether the operation was successful",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error type or title",
                      "type": "string"
                    },
                    "message": {
                      "description": "Detailed error message",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error type or title",
                      "type": "string"
                    },
                    "message": {
                      "description": "Detailed error message",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Error response",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "Error type or title",
                      "type": "string"
                    },
                    "message": {
                      "description": "Detailed error message",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "receipts"
        ],
        "description": "Delete receipt",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "path",
            "name": "receiptId",
            "required": true,
            "description": "ID of the receipt"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/receipts/{receiptId}/items": {
      "get": {
        "tags": [
          "receipts"
        ],
        "description": "Get receipt items",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "path",
            "name": "receiptId",
            "required": true,
            "description": "ID of the receipt"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "description": "A single item within a receipt",
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "Unique identifier for the receipt item",
                        "type": "number"
                      },
                      "receiptId": {
                        "description": "ID of the receipt this item belongs to",
                        "type": "number"
                      },
                      "name": {
                        "description": "Name of the purchased item",
                        "type": "string"
                      },
                      "expenseAccount": {
                        "description": "Ledger expense account for this item",
                        "type": "string"
                      },
                      "price": {
                        "description": "Price of the item",
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "receiptId",
                      "name",
                      "expenseAccount",
                      "price"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "description": "Get paginated jobs",
        "parameters": [
          {
            "schema": {
              "default": 1,
              "type": "number",
              "minimum": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number (starting from 1)"
          },
          {
            "schema": {
              "default": 30,
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "pageSize",
            "required": false,
            "description": "Number of items per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated jobs response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Paginated jobs response",
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "description": "Array of jobs",
                      "type": "array",
                      "items": {
                        "description": "A job representing an uploaded receipt to be processed",
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Unique identifier for the job",
                            "type": "number"
                          },
                          "filename": {
                            "description": "Filename of the uploaded receipt image",
                            "type": "string"
                          },
                          "fileUrl": {
                            "description": "URL to access the receipt image",
                            "type": "string"
                          },
                          "retryCount": {
                            "description": "Number of times the job has been retried",
                            "type": "number"
                          },
                          "processedAt": {
                            "description": "Timestamp when the job was processed (ISO 8601 format)",
                            "type": "string"
                          },
                          "createdAt": {
                            "description": "Timestamp when the job was created (ISO 8601 format)",
                            "type": "string"
                          },
                          "status": {
                            "description": "Status of the job (pending, processing, completed, or failed)",
                            "type": "string",
                            "enum": [
                              "waiting",
                              "processed",
                              "failed"
                            ]
                          },
                          "analysisError": {
                            "description": "Error message if the analysis failed",
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "filename",
                          "fileUrl",
                          "retryCount",
                          "createdAt",
                          "status"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "total": {
                      "description": "Total number of jobs",
                      "type": "number"
                    },
                    "page": {
                      "description": "Current page number",
                      "type": "number"
                    },
                    "pageSize": {
                      "description": "Number of items per page",
                      "type": "number"
                    },
                    "totalPages": {
                      "description": "Total number of pages",
                      "type": "number"
                    }
                  },
                  "required": [
                    "jobs",
                    "total",
                    "page",
                    "pageSize",
                    "totalPages"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{jobId}/retry": {
      "post": {
        "tags": [
          "jobs"
        ],
        "description": "Retry a failed job by resetting its status to waiting",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "path",
            "name": "jobId",
            "required": true,
            "description": "ID of the job to retry"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "description": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Health check endpoints"
    },
    {
      "name": "upload",
      "description": "Receipt upload endpoints"
    },
    {
      "name": "ledger",
      "description": "Ledger integration endpoints"
    }
  ]
}